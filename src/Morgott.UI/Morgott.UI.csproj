<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion, determinism, PathMap, embedded PDB, SourceLink off, ValheimDir/ManagedDir/BepInExCoreDir,
       polyfills, the game's BepInEx + 0Harmony references and the publicizer come from build\Valheim.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ValheimPlugin>true</ValheimPlugin>
    <ValheimUsePublicizer>true</ValheimUsePublicizer>
    <ValheimUseCore>true</ValheimUseCore>
    <ValheimUseJotunn>true</ValheimUseJotunn>
    <AssemblyName>Morgott.UI</AssemblyName>
    <RootNamespace>Morgott.UI</RootNamespace>
    <!-- Keep in sync with Plugin.Version. -->
    <Version>0.33.9</Version>
    <!-- Plugin internals are not public API (the public contract is Morgott.Core). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

<ItemGroup>
    <EmbeddedResource Include="Theme\default-theme.json" LogicalName="Morgott.UI.default-theme.json" />
    <!-- Vanilla location / room scan table for the item browser "Found in" line (dumped by autotest check item-browser-found-in). -->
    <EmbeddedResource Include="ItemBrowser\FoundInTable.txt" LogicalName="Morgott.UI.FoundInTable.txt" Condition="Exists('ItemBrowser\FoundInTable.txt')" />
    <EmbeddedResource Include="Translations\*.json" LogicalName="Morgott.UI.Translations.%(Filename).json" />
    <!-- Icons for other mods' icon-less statuses, loaded by Icons\ModStatusIcons. -->
    <EmbeddedResource Include="Assets\StatusIcons.png" LogicalName="Morgott.UI.StatusIcons.png" />
    <!-- Nemesis demon head over the enemy HUD tier socket (Codex image gen), loaded by WorldHud\EnemyHudSkin. -->
    <EmbeddedResource Include="Assets\NemesisHead.png" LogicalName="Morgott.UI.NemesisHead.png" />
    <!-- Gold paw on tameable creature cells of the item browser (Codex image gen, art v1), loaded by ItemBrowser\Browser. -->
    <EmbeddedResource Include="Assets\TameBadge.png" LogicalName="Morgott.UI.TameBadge.png" />
    <EmbeddedResource Include="Assets\SummonBadge.png" LogicalName="Morgott.UI.SummonBadge.png" />
    <EmbeddedResource Include="Assets\MapLayersIcon.png" LogicalName="Morgott.UI.MapLayersIcon.png" />
    <EmbeddedResource Include="Assets\MapBossIcon.png" LogicalName="Morgott.UI.MapBossIcon.png" />
    <!-- Portal style icons, Core PortalStyle ids 1..32 (tools\portalatlas packs Assets\PortalIcons\NN_name.png). -->
    <EmbeddedResource Include="Assets\PortalIcons.png" LogicalName="Morgott.UI.PortalIcons.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Restyled item icons (Icons\IconRestyle): BC7 pages + manifest ship as files in <plugin>\icons\ (too big to embed);
         the lossless ItemIcons_NN.png masters stay in the repo for the next additive pack (MorgottTweaks tools\iconstyle). -->
    <None Include="Assets\ItemIcons\ItemIcons.json;Assets\ItemIcons\*.bc7.gz" Link="icons\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Morgott.DevTools.IconCapture reads Icons.IconRestyle.Originals (dev tool, never in the pack). -->
    <InternalsVisibleTo Include="Morgott.DevTools.IconCapture" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>$(ManagedDir)\gui_framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Location / dungeon room prefabs are SoftReference<GameObject> (item browser "Found in" scan). -->
    <!-- Steam build id for the Found in table guard (SteamApps.GetAppBuildId). -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SoftReferenceableAssets">
      <HintPath>$(ManagedDir)\SoftReferenceableAssets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ClothModule">
      <HintPath>$(ManagedDir)\UnityEngine.ClothModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GlyphMetrics / GlyphRect for the runtime TMP sprite asset (DamageIcons). -->
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
